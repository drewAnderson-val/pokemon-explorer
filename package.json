{
  "name": "pokemon-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "cd api && DATABASE_URL=postgresql://postgres:postgres@localhost:54329/pokemon JWT_SECRET=dev uv run uvicorn app.asgi:app --reload --port 8000",
    "db:log-sql": "docker compose exec db psql -U postgres -qc \"ALTER SYSTEM SET log_statement = 'all'\" -c 'SELECT pg_reload_conf()' && docker compose logs -f --since 1s db",
    "db:quiet": "docker compose exec db psql -U postgres -qc 'ALTER SYSTEM RESET log_statement' -c 'SELECT pg_reload_conf()'",
    "build": "tsc -b && vite build && vite build --ssr server/index.ts --outDir dist-server",
    "start": "node dist-server/index.js",
    "server": "pnpm build && pnpm start",
    "preview": "vite preview",
    "types": "tsc --noEmit",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@faker-js/faker": "10.4.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@google/genai": "2.29.1",
    "@radix-ui/react-slot": "1.2.4",
    "@tanstack/react-query": "5.104.2",
    "clsx": "2.1.1",
    "express": "5.2.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.8.3",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/express": "5.0.6",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.9.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "prettier": "3.8.3",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.0.13",
    "vitest": "5.0.4"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "avoid"
  },
  "packageManager": "pnpm@11.2.1+sha512.4c4c142b276348da01d39907cce2f40bf61281212a0e43295ee988055d50cce728ab7e9c181e252e4bce3a4f19ba1cff1a75b1e2e0fd6b17ba0be598a5e45446",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
